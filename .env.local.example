# Supabase project settings — find these in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the browser. The weekly reminders job uses this
# to write notifications, which authenticated users deliberately cannot insert.
SUPABASE_SECRET_KEY=

# Shared secret for the scheduled reminders route. Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>`. The route fails closed without it.
CRON_SECRET=

# Email delivery (optional). Without these the reminders job still records
# every notification in the portal; it just skips sending the digest.
# RESEND_API_KEY is provisioned by the Vercel Resend integration.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=

# SharePoint document mirror (optional).
# Register an application in Azure with the Sites.Selected application
# permission, then grant it write access to the target site. Without these the
# portal simply holds documents itself and the mirror stays off.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
